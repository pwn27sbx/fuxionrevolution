---
import "../styles/global.css";
import "../styles/fuxion.css";
const { title = "Fuxion Landing", description = "" } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:wght@700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-dvh bg-slate-950 text-slate-50">
    <main class="h-dvh snap-y snap-mandatory overflow-y-auto">
      <slot />
    </main>
  </body>
</html>
