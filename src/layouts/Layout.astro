---
import "../styles/global.css";
import "../styles/fuxion.css";
const { title = "Fuxion Landing", description = "" } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:wght@700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-dvh bg-slate-950 text-slate-50">
    <main class="h-dvh snap-y snap-mandatory overflow-y-auto">
      <slot />
    </main>

    <audio id="musica-fondo" loop>
      <source src="/audio/Fuxion.mp3" type="audio/mpeg" />
    </audio>
  </body>

  <script>
    // 1. Desactiva el clic derecho en toda la página por seguridad
    document.addEventListener("contextmenu", function (e) {
      e.preventDefault();
    });

    // 2. Lógica premium para reproducir el audio de fondo
    document.addEventListener("DOMContentLoaded", () => {
      // AQUÍ ESTÁ LA MAGIA: Le decimos a TypeScript que esto es un Audio
      const musica = document.getElementById(
        "musica-fondo",
      ) as HTMLAudioElement;

      if (musica) {
        // Ahora TypeScript sabe perfectamente que .volume y .play() existen
        musica.volume = 0.08;

        // Intentamos reproducir la música apenas carga la web
        let intentarReproducir = musica.play();

        if (intentarReproducir !== undefined) {
          // Dejamos los paréntesis vacíos () para que TS no pida el tipo de error
          intentarReproducir.catch(() => {
            console.log(
              "El navegador bloqueó el autoplay. Esperando interacción del usuario...",
            );

            // Si el navegador bloquea el audio, esperamos a que el usuario toque la pantalla
            const iniciarAudio = () => {
              musica.play();
            };

            // Ejecutará el audio con el primer clic o toque en el celular
            document.body.addEventListener("click", iniciarAudio, {
              once: true,
            });
            document.body.addEventListener("touchstart", iniciarAudio, {
              once: true,
            });
          });
        }
      }
    });
  </script>
</html>
