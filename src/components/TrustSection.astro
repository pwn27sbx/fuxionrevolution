---
import { siteConfig } from "../data/config";
import StoryCard from "./StoryCard.astro";
import { Image } from "astro:assets";
---

<section class="panel section-shell" id="confianza">
  <div class="container section-frame bento-frame">
    <div class="section-top">
      <div>
        <p class="eyebrow">Confianza y testimonios</p>
        <h2 class="title">
          Personas reales. Resultados visibles. Una comunidad que inspira.
        </h2>
      </div>
    </div>

    <div class="trust-layout">
      <div class="visual-column">
        <div class="gallery-grid">
          <article class="gallery-item video-item">
            <video
              muted
              loop
              playsinline
              preload="none"
              class="lazy-video"
              style="width: 100%; height: 100%; object-fit: cover; border-radius: 18px;"
            >
              <source src="/videos/short2.webm" type="video/webm" />
              <source src="/videos/short2.mp4" type="video/mp4" />
            </video>
          </article>
          <div class="gallery-stack">
            <article class="gallery-item">
              <Image
                src="https://images.unsplash.com/photo-1517457373958-b7bdd4587205?auto=format&fit=crop&w=600&q=80"
                alt="Testimonio visual de bienestar"
                width={600}
                height={300}
                loading="lazy"
              />
            </article>
            <article class="gallery-item">
              <Image
                src="https://images.unsplash.com/photo-1511988617509-a57c8a288659?auto=format&fit=crop&w=600&q=80"
                alt="Estilo de vida asociado a comunidad y crecimiento"
                width={600}
                height={300}
                loading="lazy"
              />
            </article>
          </div>
        </div>
      </div>

      <div class="story-column">
        <div class="story-row">
          <StoryCard 
            eyebrow="APRENDE Y CRECE"
            title="Sistema Educativo Virtual"
            description="Domina las habilidades clave para llevar tu negocio al siguiente nivel."
            link={siteConfig.links.virtualSystem}
          />
          <StoryCard 
            eyebrow="CUMPLE TUS SUEÑOS"
            title="Comunidad y Liderazgo"
            description="Únete a un equipo apasionado que te impulsará hacia tu libertad financiera."
          />
        </div>

        <article class="feature-visual">
          <video muted loop playsinline preload="none" class="lazy-video">
            <source src="/videos/video2.webm" type="video/webm" />
            <source src="/videos/video2.mp4" type="video/mp4" />
          </video>
          <div class="feature-overlay">
            <h3>Historias que conectan desde el primer vistazo</h3>
            <p>
              Una experiencia visual que mezcla comunidad, bienestar y
              aspiración para generar confianza más rápido.
            </p>
          </div>
        </article>

        <div class="micro-stats">
          <div class="micro-stat">
            <span>+ DE 150 MIL ASOCIADOS</span>
          </div>
          <div class="micro-stat">
            <span>+ DE 38 PAISES</span>
          </div>
          <div class="micro-stat">
            <span>MILES DE SUEÑOS CUMPLIDOS</span>
          </div>
        </div>
      </div>
    </div>

    <footer class="social-footer">
      <div class="social-links">
        <a
          href={siteConfig.social.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
        >
          <svg
            viewBox="0 0 24 24"
            width="24"
            height="24"
            stroke="currentColor"
            stroke-width="2"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path
              d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line
              x1="17.5"
              y1="6.5"
              x2="17.51"
              y2="6.5"></line></svg
          >
        </a>
        <a
          href={siteConfig.social.youtube}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="YouTube"
        >
          <svg
            viewBox="0 0 24 24"
            width="24"
            height="24"
            stroke="currentColor"
            stroke-width="2"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg
          >
        </a>
        <a
          href={siteConfig.social.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp"
        >
          <svg
            viewBox="0 0 24 24"
            width="24"
            height="24"
            stroke="currentColor"
            stroke-width="2"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
            ></path></svg
          >
        </a>
        <a
          href={siteConfig.social.facebook}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
        >
          <svg
            viewBox="0 0 24 24"
            width="24"
            height="24"
            stroke="currentColor"
            stroke-width="2"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
            ></path></svg
          >
        </a>
      </div>
      <p class="copyright">
        © 2026 Fuxion Experience. Todos los derechos reservados.
      </p>
    </footer>
  </div>
</section>

<script>
  import { animate, inView, stagger } from "motion";

  document.addEventListener("DOMContentLoaded", () => {
    // Motion animations
    let topAnimated = false;
    inView("#confianza .section-top", ({ target }) => {
      if (topAnimated) return;
      topAnimated = true;
      animate(target, { opacity: [0, 1], y: [20, 0] }, { duration: 0.8 });
    }, { margin: "-50px" });

    let galleryAnimated = false;
    inView(".gallery-grid", ({ target }) => {
      if (galleryAnimated) return;
      galleryAnimated = true;
      animate(
        target.querySelectorAll(".gallery-item"),
        { opacity: [0, 1], scale: [0.95, 1], rotate: [-2, 0] },
        { delay: stagger(0.15), duration: 0.8, ease: "easeOut" }
      );
    }, { margin: "-50px" });

    let storyAnimated = false;
    inView(".story-row", ({ target }) => {
      if (storyAnimated) return;
      storyAnimated = true;
      animate(
        target.querySelectorAll(".story-card"),
        { opacity: [0, 1], x: [30, 0] },
        { delay: stagger(0.15), duration: 0.7, ease: "easeOut" }
      );
    }, { margin: "-50px" });

    let statsAnimated = false;
    inView(".micro-stats", ({ target }) => {
      if (statsAnimated) return;
      statsAnimated = true;
      animate(
        target.querySelectorAll(".micro-stat"),
        { opacity: [0, 1], y: [20, 0] },
        { delay: stagger(0.1), duration: 0.6 }
      );
    }, { margin: "-50px" });

    // Lazy videos
    const lazyVideos = document.querySelectorAll(".lazy-video");
    
    if ("IntersectionObserver" in window) {
      const videoObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((video) => {
          if (video.isIntersecting) {
            const vidElement = video.target as HTMLVideoElement;
            vidElement.play();
          } else {
            const vidElement = video.target as HTMLVideoElement;
            vidElement.pause();
          }
        });
      }, { rootMargin: "0px 0px 200px 0px" });

      lazyVideos.forEach((video) => {
        videoObserver.observe(video);
      });
    }
  });
</script>
