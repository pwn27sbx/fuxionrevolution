---
import { siteConfig } from "../data/config";
---

<section class="panel" id="hero">
  <div class="hero-video">
    <video
      autoplay
      muted
      loop
      playsinline
      style="width: 100%; height: 100%; object-fit: cover; border-radius: 18px;"
    >
      <source src="/videos/omg.webm" type="video/webm" />
      <source src="/videos/omg.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="hero-overlay"></div>
  <div class="hero-noise"></div>
  <div class="hero-glow"></div>

  <div class="container hero-content">
    <header class="nav">
      <div class="brand-block hero-label-row">
        <p class="eyebrow">
          <span>FUXION</span>
          <span>EXPERIENCE</span>
        </p>
      </div>
      <a class="ghost hero-products-btn" href="#productos">Ver productos</a>
    </header>

    <div class="hero-grid">
      <div class="impact-copy">
        <h1>Ahora te toca a ti. Ellos ya lo hicieron.</h1>

        <div class="cta-row">
          <a class="ghost" href="#confianza">Ver testimonios</a>
          <a
            class="primary"
            href={siteConfig.links.enrollment}
            >Quiero empezar</a
          >
        </div>
      </div>

      <div class="hero-side">
        <article class="floating-card">
          <video
            autoplay
            muted
            loop
            playsinline
            poster="/card-poster.jpg"
            style="width: 100%; height: 100%; object-fit: cover; border-radius: 18px;"
          >
            <source src="/videos/short.webm" type="video/webm" />
            <source src="/videos/short.mp4" type="video/mp4" />
          </video>
        </article>
        <div class="floating-mini">
          <div class="floating-pill">CRECE</div>
          <div class="floating-pill">DESTACA</div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate, stagger } from "motion";

  document.addEventListener("DOMContentLoaded", () => {
    // Nav animation
    animate(".nav", { y: [-20, 0], opacity: [0, 1] }, { duration: 0.8, delay: 0.2 });
    
    // Main text and CTA animation
    animate(
      ".impact-copy h1, .impact-copy .cta-row",
      { y: [30, 0], opacity: [0, 1] },
      { delay: stagger(0.2, { startDelay: 0.4 }), duration: 0.8, ease: "easeOut" }
    );
    
    // Floating cards animation
    animate(
      ".floating-card",
      { y: [40, 0], opacity: [0, 1], rotate: [-5, 0] },
      { delay: 0.6, duration: 1, ease: "easeOut" }
    );
    
    animate(
      ".floating-pill",
      { scale: [0.8, 1], opacity: [0, 1] },
      { delay: stagger(0.2, { startDelay: 1 }), duration: 0.6, ease: "backOut" }
    );
  });
</script>
