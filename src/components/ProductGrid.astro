---
import { Image } from "astro:assets";
import { products } from "../data/config";
---

<section class="panel section-shell" id="productos">
  <div class="container section-frame">
    <div class="section-top">
      <div>
        <p class="eyebrow">Productos destacados</p>
        <h2 class="title">
          Sentirte bien no es opcional, es parte de cada día.
        </h2>
      </div>
    </div>

    <div class="carousel-mask">
      <div class="product-grid">
        {
          products.map((product) => (
            <article class="product-card">
              <div class="product-image">
                <Image
                  src={product.image}
                  alt={`Envase de ${product.name}`}
                  width={400}
                  height={400}
                  loading="lazy"
                />
              </div>
              <div class="product-body">
                <h3>{product.name}</h3>
                <p>{product.description}</p>
                <div class="product-actions">
                  <a
                    class="mini-btn buy"
                    href={product.link}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Comprar
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { animate, inView, stagger } from "motion";

  document.addEventListener("DOMContentLoaded", () => {
    let gridAnimated = false;
    inView(".product-grid", ({ target }) => {
      if (gridAnimated) return;
      gridAnimated = true;
      animate(
        target.querySelectorAll(".product-card"),
        { opacity: [0, 1], y: [40, 0], scale: [0.95, 1] },
        { delay: stagger(0.1), duration: 0.6, ease: "easeOut" }
      );
    }, { margin: "-50px" });

    let titleAnimated = false;
    inView(".section-top", ({ target }) => {
      if (titleAnimated) return;
      titleAnimated = true;
      animate(
        target,
        { opacity: [0, 1], y: [20, 0] },
        { duration: 0.8, ease: "easeOut" }
      );
    });
  });
</script>
